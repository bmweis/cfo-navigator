# Required for Q&A, enrichment, and post drafting
ANTHROPIC_API_KEY=sk-ant-...

# Path to the SQLite database (default: library.db beside the code)
# LINKLIB_DB=library.db

# --- Auth (protects /library, /feed, /read, and the save/ask/post APIs) ---
# Shared secret for POST /save + the bookmarklet, and the DEFAULT login password.
# Set this when the app is publicly hosted; leave unset for an open local instance.
# LINKLIB_SAVE_TOKEN=your-secret-token
#
# Optional: a separate login password (defaults to LINKLIB_SAVE_TOKEN if unset).
# LINKLIB_PASSWORD=your-login-password
#
# Optional but recommended when hosted: HMAC key for signing session cookies.
# If unset, logins reset on every app restart/deploy (you just sign in again).
# LINKLIB_SECRET_KEY=a-long-random-string

# Claude models (defaults shown — verify current IDs at docs.anthropic.com/en/docs/about-claude/models)
# LINKLIB_ENRICH_MODEL=claude-haiku-4-5-20251001
# LINKLIB_CHAT_MODEL=claude-sonnet-4-6

# Base URL used in the bookmarklet (set to your public hostname when hosted)
# LINKLIB_PUBLIC_BASE=https://yoursite.com

# Path to OPML for web-search domain allowlist
# LINKLIB_SITES_OPML=preferred_sites.opml

# Your current title/role — appears in LinkedIn post drafts (update when it changes)
# LINKLIB_AUTHOR_TITLE=CFO

# --- Google Workspace: Drive backup + outbound email (optional) ---
# One OAuth client powers both features. When the three GOOGLE_OAUTH_* vars
# are set:
#   - the app pushes a consistent snapshot of the library to Google Drive at
#     most once per week (after a save); force one anytime at /admin/backup-now
#   - contact-form submissions and CFO Toolbox warm intros are emailed via the
#     Gmail REST API over HTTPS (NOT SMTP — Railway's Hobby plan blocks SMTP
#     ports; the Gmail API works on every plan)
# Setup: in Google Cloud Console, enable the Drive API and Gmail API, create
# an OAuth client, and authorize ONCE with BOTH scopes — drive.file and
# gmail.send — using the Workspace account that should own backups and send
# mail. That yields the refresh token below.
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REFRESH_TOKEN=...
# GOOGLE_DRIVE_FOLDER_ID=...   # Drive folder ID for snapshots (default: My Drive root)
#
# Sender address for outbound email — the mailbox that authorized the refresh
# token (or one of its send-as aliases).
# LINKLIB_FROM_EMAIL=hello@bmweis.com
# Where contact-form submissions land (defaults to LINKLIB_FROM_EMAIL).
# LINKLIB_CONTACT_EMAIL=brian.weisberg@gmail.com
