# Required for Q&A, enrichment, and post drafting
ANTHROPIC_API_KEY=sk-ant-...

# Optional: powers embed-on-save/backfill and the vector half of hybrid
# retrieval (linklib/embeddings.py). Absent → FTS5-only search, no error.
# OPENAI_API_KEY=sk-...

# Path to the SQLite database (default: library.db beside the code)
# LINKLIB_DB=library.db

# --- Auth (protects /library, /feed, /read, and the save/ask/post APIs) ---
# Shared secret for POST /save + the bookmarklet, and the DEFAULT login password.
# Set this when the app is publicly hosted; leave unset for an open local instance.
# LINKLIB_SAVE_TOKEN=your-secret-token
#
# Optional: a separate login password (defaults to LINKLIB_SAVE_TOKEN if unset).
# LINKLIB_PASSWORD=your-login-password
#
# Optional: the admin username label (default: admin).
# LINKLIB_ADMIN_USERNAME=admin
#
# Optional but recommended when hosted: HMAC key for signing session cookies.
# If unset, logins reset on every app restart/deploy (you just sign in again).
# LINKLIB_SECRET_KEY=a-long-random-string

# Claude models (defaults shown — verify current IDs at docs.anthropic.com/en/docs/about-claude/models)
# LINKLIB_ENRICH_MODEL=claude-opus-5
# LINKLIB_CHAT_MODEL=claude-sonnet-4-6
# LINKLIB_EMBED_MODEL=text-embedding-3-small
# LINKLIB_TAG_GUIDE_MODEL=claude-opus-4-8
# LINKLIB_QUEUE_ENRICH_MODEL=claude-opus-4-8
# LINKLIB_DEDUPE_MODEL=claude-sonnet-4-6

# Base URL used in the bookmarklet (set to your public hostname when hosted)
# LINKLIB_PUBLIC_BASE=https://bmweis.com

# Path to OPML for web-search domain allowlist
# LINKLIB_SITES_OPML=preferred_sites.opml

# --- Subscriber cookies for paywalled feeds (optional) ---
# One variable per domain, each holding a raw `Cookie` header value — no
# JSON, nothing to parse. A domain must also be listed in
# linklib/extract.py's _COOKIE_DOMAINS before its variable is read; adding a
# new domain needs both a code change there and its variable here. See
# RUNBOOK.md §5-6 for how to find a cookie value and the naming convention
# behind LINKLIB_COOKIE_<DOMAIN>.
# LINKLIB_COOKIE_MOSTLYMETRICS_COM=connect.sid=...
# LINKLIB_COOKIE_ONLYCFO_IO=...

# Contact-form spam guards (defaults shown)
# LINKLIB_CONTACT_RATE_LIMIT_PER_HOUR=5
# LINKLIB_CONTACT_TIME_TRAP_SECONDS=3

# Exa search API key — powers FP&A Buddy's web retrieval tier (linklib/agent.py
# retrieve_exa, domain-restricted to the sites list below). Optional: absent,
# Buddy answers from the saved library + feed alone, no error.
# EXA_API_KEY=...

# CFO Toolbox logo backfill (optional, scripts/backfill_logos.py only).
# Brand API Bearer token — a different product/credential from
# BRANDFETCH_CLIENT_ID below, do not confuse the two.
# BRANDFETCH_API_KEY=...
# BRANDFETCH_CLIENT_ID=...

# --- Google Workspace: Drive backup + outbound email (optional) ---
# One OAuth client powers both features. When the three GOOGLE_OAUTH_* vars
# are set:
#   - the app pushes a consistent snapshot of the library to Google Drive
#     daily (after a save); force one anytime at /admin/backup-now
#   - contact-form submissions and CFO Toolbox warm intros are emailed via the
#     Gmail REST API over HTTPS (NOT SMTP — Railway's Hobby plan blocks SMTP
#     ports; the Gmail API works on every plan)
# Setup: in Google Cloud Console, enable the Drive API and Gmail API, create
# an OAuth client, and authorize ONCE with BOTH scopes — drive.file and
# gmail.send — using the Workspace account that should own backups and send
# mail. That yields the refresh token below.
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REFRESH_TOKEN=...
# GOOGLE_DRIVE_FOLDER_ID=...   # Explicit override only — normally left unset; the app creates and remembers its own folder on first backup (see CLAUDE.md's Phase O note).
#
# Sender address for outbound email — the mailbox that authorized the refresh
# token (or one of its send-as aliases).
# LINKLIB_FROM_EMAIL=hello@bmweis.com
# Where contact-form submissions land (defaults to LINKLIB_FROM_EMAIL).
# LINKLIB_CONTACT_EMAIL=brian.weisberg@gmail.com
