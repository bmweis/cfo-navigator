# Required for Q&A, enrichment, and post drafting
ANTHROPIC_API_KEY=sk-ant-...

# Path to the SQLite database (default: library.db beside the code)
# LINKLIB_DB=library.db

# Auth token for POST /save — set this when the app is publicly hosted
# LINKLIB_SAVE_TOKEN=your-secret-token

# Claude models (defaults shown — verify current IDs at docs.anthropic.com/en/docs/about-claude/models)
# LINKLIB_ENRICH_MODEL=claude-haiku-4-5-20251001
# LINKLIB_CHAT_MODEL=claude-sonnet-4-6

# Base URL used in the bookmarklet (set to your public hostname when hosted)
# LINKLIB_PUBLIC_BASE=https://yoursite.com

# Path to OPML for web-search domain allowlist
# LINKLIB_SITES_OPML=preferred_sites.opml

# Your current title/role — appears in LinkedIn post drafts (update when it changes)
# LINKLIB_AUTHOR_TITLE=CFO
